{
  "name": "mas-office",
  "version": "0.1.0",
  "description": "MAS Office CLI: serve the animated office panel for any multi-agent system, validate snapshots, replay event logs, and run a demo.",
  "type": "module",
  "bin": {
    "mas-office": "bin/mas-office.js"
  },
  "exports": {
    ".": "./src/cli.js",
    "./server": "./src/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "panel",
    "schemas",
    "kit",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mas-office/sdk": "0.1.0"
  },
  "scripts": {
    "test": "node --test test/schema.test.js test/validate.test.js test/server.test.js test/hook.test.js test/export.test.js test/cli.test.js",
    "prepack": "node scripts/bundle.js",
    "postpack": "node scripts/bundle.js --clean"
  },
  "keywords": [
    "multi-agent",
    "agents",
    "llm",
    "observability",
    "visualization",
    "dashboard",
    "cli",
    "claude-code",
    "ag-ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weixijia/mas-office.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/weixijia/mas-office#readme",
  "bugs": "https://github.com/weixijia/mas-office/issues"
}
