{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weixijia/mas-office/main/spec/schemas/env.schema.json",
  "title": "MAS Office producer environment",
  "type": "object",
  "properties": {
    "tool": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "canWrite": {
      "type": "boolean"
    },
    "canSearch": {
      "type": "boolean"
    },
    "canBrowse": {
      "type": "boolean"
    },
    "subagents": {
      "enum": [
        "parallel",
        "sequential"
      ]
    },
    "setupAt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
