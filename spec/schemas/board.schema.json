{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weixijia/mas-office/main/spec/schemas/board.schema.json",
  "title": "MAS Office board (mas/board)",
  "type": "object",
  "required": [
    "tasks",
    "reviews",
    "recoveries"
  ],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "agentId",
          "title",
          "state"
        ],
        "properties": {
          "taskId": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "brief": {
            "type": [
              "string",
              "null"
            ]
          },
          "from": {
            "type": "string"
          },
          "round": {
            "type": "number"
          },
          "attempt": {
            "type": "number"
          },
          "state": {
            "enum": [
              "assigned",
              "working",
              "blocked",
              "review",
              "done"
            ]
          },
          "say": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "enum": [
              "success",
              "failed",
              "cancelled",
              null
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "ledger": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "satisfied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "looping": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "progressing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "instruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "stalls": {
          "type": [
            "number",
            "null"
          ]
        },
        "updated": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "target",
          "verdict"
        ],
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "accept",
              "revise",
              "escalate"
            ]
          },
          "round": {
            "type": "number"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "recoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "by",
          "strategy"
        ],
        "properties": {
          "by": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "retry",
              "reassign",
              "replan",
              "split",
              "ask-human"
            ]
          },
          "target": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "inputTokens": {
            "type": "number"
          },
          "outputTokens": {
            "type": "number"
          },
          "costUsd": {
            "type": "number"
          },
          "turns": {
            "type": "number"
          },
          "limit": {
            "type": [
              "object",
              "null"
            ]
          },
          "updated": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "backend": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "session": {
            "type": [
              "object",
              "null"
            ]
          },
          "accepts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewerOf": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
