{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weixijia/mas-office/main/spec/schemas/structure.schema.json",
  "title": "MAS Office structure",
  "type": "object",
  "required": [
    "lead",
    "roles"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "locked": {
      "type": "boolean"
    },
    "topology": {
      "enum": [
        "staged",
        "graph",
        "dynamic"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "lead": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "const": "lead"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "serves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "handsTo": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "parent": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "emoji": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "serves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "handsTo": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "dynamic": {
            "type": "boolean"
          },
          "parent": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    }
  }
}
