{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weixijia/mas-office/main/spec/schemas/structure.schema.json",
  "title": "MAS Office structure",
  "type": "object",
  "required": [
    "lead",
    "roles"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "locked": {
      "type": "boolean"
    },
    "signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "topology": {
      "enum": [
        "staged",
        "graph",
        "dynamic"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxParallel": {
          "type": "integer",
          "minimum": 1
        },
        "maxTurnMinutes": {
          "type": "number",
          "minimum": 0
        },
        "maxRunMinutes": {
          "type": "number",
          "minimum": 0
        },
        "maxQuestionsPerRole": {
          "type": "integer",
          "minimum": 1
        },
        "stallMinutes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lead": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "const": "lead"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "emoji": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "serves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ],
            "minLength": 1,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "effect": {
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              }
            }
          }
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "handsTo": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string"
        },
        "dynamic": {
          "type": "boolean"
        },
        "parent": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "backend": {
          "enum": [
            "claude-code",
            "codex"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "delegate": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {
                "enum": [
                  "allow",
                  "lead",
                  "human"
                ]
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "subjectTypes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "max": {
                "type": "integer",
                "minimum": 1
              },
              "expires": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "emoji": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "serves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "object"
              ],
              "minLength": 1,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                }
              }
            }
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "handsTo": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string"
          },
          "dynamic": {
            "type": "boolean"
          },
          "parent": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "output": {
            "type": "string"
          },
          "backend": {
            "enum": [
              "claude-code",
              "codex"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewerOf": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cleanContext": {
            "type": "boolean"
          },
          "review": {
            "type": "object",
            "properties": {
              "maxRounds": {
                "type": "integer",
                "minimum": 1
              },
              "onExceed": {
                "enum": [
                  "ask-human"
                ]
              }
            }
          },
          "unknownTools": {
            "enum": [
              "ask",
              "deny"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "plan",
              "stage",
              "final"
            ]
          },
          "title": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "boolean"
        },
        "urlHealth": {
          "type": "boolean"
        },
        "flagWhen": {
          "type": "object",
          "properties": {
            "contradicted": {
              "type": "integer",
              "minimum": 1
            },
            "unknownShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hallucinated": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
