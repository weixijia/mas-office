{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/weixijia/mas-office/main/spec/schemas/projects.schema.json",
  "title": "MAS Office workspace index (home/projects)",
  "type": "object",
  "required": [
    "projects"
  ],
  "properties": {
    "current": {
      "type": [
        "string",
        "null"
      ]
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "folder"
        ],
        "properties": {
          "folder": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "title": {
            "type": "string"
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "phase": {
            "type": "string"
          },
          "agents": {
            "type": "integer",
            "minimum": 0
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
