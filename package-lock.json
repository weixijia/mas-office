{
  "name": "mas-office-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mas-office-monorepo",
      "license": "MIT",
      "workspaces": [
        "packages/js",
        "packages/cli"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "node_modules/@mas-office/sdk": {
      "resolved": "packages/js",
      "link": true
    },
    "node_modules/mas-office": {
      "resolved": "packages/cli",
      "link": true
    },
    "packages/cli": {
      "name": "mas-office",
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "@mas-office/sdk": "0.1.0"
      },
      "bin": {
        "mas-office": "bin/mas-office.js"
      },
      "engines": {
        "node": ">=18"
      }
    },
    "packages/js": {
      "name": "@mas-office/sdk",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
